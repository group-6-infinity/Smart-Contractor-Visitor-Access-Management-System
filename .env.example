TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used to AES-256-GCM encrypt trackingToken before it ever appears in a
# URL or on-screen to an applicant/visitor (lib/token-crypto.ts). Any
# string works — it's hashed into a 32-byte key. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Secret required as `Authorization: Bearer <CRON_SECRET>` to manually
# trigger /api/cron/document-expiry (FR-010). The automatic daily run is
# scheduled in-process (see instrumentation.ts) and doesn't need this —
# it's only for manual/ops re-runs.
CRON_SECRET=

DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

BLOB_READ_WRITE_TOKEN=
