generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id              String             @id @default(cuid())
  trackingToken   String             @unique
  createdById     String?
  type            RegistrationType
  fullName        String
  company         String
  email           String
  phone           String?
  photoPath       String?
  status          RegistrationStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime?          @updatedAt
  users           users?             @relation(fields: [createdById], references: [id])
  Visit           Visit[]
  documents       documents[]
  CheckEvent      CheckEvent[]

  @@unique([email, type])
}

model Visit {
  id              String       @id @default(cuid())
  registrationId  String
  purpose         String
  visitDate       DateTime
  windowStart     DateTime
  windowEnd       DateTime
  authorizedZones String[]
  status          VisitStatus  @default(PENDING)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  Registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  CheckEvent CheckEvent[]
}

model documents {
  id             String       @id @default(cuid())
  registrationId String
  type           DocumentType
  filePath       String
  expiryDate     DateTime?
  isVerified     Boolean      @default(false)
  isActive       Boolean      @default(true)
  verifiedById   String?
  verifiedAt     DateTime?
  replacedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  users          users?       @relation(fields: [verifiedById], references: [id])
}

model users {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  passwordHash String
  role         Role
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Registration Registration[]
  documents    documents[]

  @@unique([name, email])
}

model Blacklist {
  id             String   @id @default(cuid())
  registrationId String?
  fullName       String
  email          String
  reason         String
  blacklistedBy  String
  createdAt      DateTime @default(now())

  @@index([email])
}

model CheckEvent {
  id                    String      @id @default(cuid())
  visitId               String
  registrationId        String
  checkInAt             DateTime    @default(now())
  checkInBy             String
  checkOutAt            DateTime?
  checkOutBy            String?
  zones                 String[]
  status                CheckStatus @default(INSIDE)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  riskLevel             RiskLevel?
  isOverride            Boolean     @default(false)
  overrideJustification String?
  overrideBy            String?

  Visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  Registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([registrationId])
}

model Notification {
  id        String              @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime            @default(now())

  @@index([createdAt])
}

model NotificationRead {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastReadAt DateTime @default(now())

  @@index([userId])
}

model Zone {
  id          String    @id @default(cuid())
  name        String
  description String?
  riskLevel   RiskLevel @default(LOW)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EvacuationSnapshot {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

enum CheckStatus {
  INSIDE
  CHECKED_OUT
  OVERSTAY
  DENIED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  BLACKLIST_ALERT
  TELEGRAM_MESSAGE
  DOCUMENT_EXPIRY
  OVERSTAY_ALERT
  VISIT_REQUEST
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL
}

enum ConsentStatus {
  ACTIVE
  REVOKED
}

enum DocumentType {
  KTP
  BPJS
  SIO
  SIA
  FACE_PHOTO
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationType {
  CONTRACTOR
  VISITOR
}

enum Role {
  SECURITY_OPERATOR
  HSE_ADMIN
  HR_ADMIN
}

enum VisitStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}
